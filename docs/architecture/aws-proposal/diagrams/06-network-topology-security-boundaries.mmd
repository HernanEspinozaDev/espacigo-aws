    Client -- "HTTPS :443" --> CF_Proxy
    CF_Proxy -- "HTTPS / Origin Pull\n(Filtrado por Cloudflare IP Prefix List)" --> IGW --> SG_App --> C_Web
    C_API -- "TCP :5432 (TLS verify-full\nDATABASE_CONNECTION_MODE=direct)" --> SG_DB --> RDS_Node
    C_API -- "Ruta Privada AWS" --> VPCE_S3 --> S3_Buckets
    C_API -- "STARTTLS :587" --> Zoho_SMTP
    Fargate_Pod -. "IAM Execution Role (Solo al iniciar)" .-> SSM_Store
